{
  "name": "orion-agent",
  "version": "1.0.0",
  "description": "Orion Agent — Intelligent Cosmic AI Platform & Assistant",
  "type": "module",
  "main": "backend/src/server.js",
  "bin": {
    "orion": "./bin/orion.js",
    "orion-agent": "./bin/orion.js"
  },
  "scripts": {
    "start": "node bin/orion.js",
    "orion": "node bin/orion.js",
    "view": "node bin/orion.js --view",
    "build": "npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "orion",
    "orion-agent",
    "ai",
    "assistant",
    "chat",
    "cli",
    "agent"
  ],
  "author": "Lanvry <wardilanang46@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0"
  }
}
